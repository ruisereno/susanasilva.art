---
import SiteLayout from "../layouts/SiteLayout.astro";
import { artworks } from "../data/artworks";
---

<SiteLayout
  activePage="work"
  title="Work — Susana Silva"
  description="Explore a selection of illustrations by Susana Silva: portraits, botanicals, and colorful compositions."
>
  <main>
    <section id="work" aria-labelledby="work-heading">
      <div class="section-heading">
        <h1 id="work-heading">selected illustrations</h1>
      </div>
      <div class="gallery">
        {artworks.map((artwork, index) => (
          <button
            class="artwork"
            type="button"
            data-artwork={index}
            data-detail-mobile={artwork.detail.mobile}
            data-detail-tablet={artwork.detail.tablet}
            data-detail-desktop={artwork.detail.desktop}
            aria-label={`Enlarge illustration: ${artwork.description}`}
            aria-haspopup="dialog"
          >
            <picture>
              <source
                media="(max-width: 540px)"
                srcset={artwork.gallery.mobile}
              />
              <source
                media="(max-width: 900px)"
                srcset={artwork.gallery.tablet}
              />
              <img
                src={artwork.gallery.desktop}
                alt={artwork.description}
                width={artwork.width}
                height={artwork.height}
                loading={index < 3 ? "eager" : "lazy"}
                decoding="async"
              />
            </picture>
          </button>
        ))}
      </div>
    </section>
  </main>
  <dialog class="viewer" aria-label="Illustration viewer">
    <div class="viewer-top">
      <span class="counter" aria-live="polite"></span>
      <button
        class="close"
        type="button"
        aria-label="Close illustration viewer"
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <picture class="viewer-picture">
      <source class="viewer-mobile" media="(max-width: 540px)" />
      <source class="viewer-tablet" media="(max-width: 900px)" />
      <img class="viewer-image" alt="" />
    </picture>
    <div class="viewer-bottom">
      <button class="previous" type="button" aria-label="Previous illustration">
        ← previous
      </button>
      <p class="description"></p>
      <button class="next" type="button" aria-label="Next illustration">
        next →
      </button>
    </div>
  </dialog>
</SiteLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".viewer")!;
  const image = dialog.querySelector<HTMLImageElement>(".viewer-image")!;
  const mobile = dialog.querySelector<HTMLSourceElement>(".viewer-mobile")!;
  const tablet = dialog.querySelector<HTMLSourceElement>(".viewer-tablet")!;
  const counter = dialog.querySelector<HTMLElement>(".counter")!;
  const description = dialog.querySelector<HTMLElement>(".description")!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>(".artwork")];
  let current = 0;
  function show(index: number) {
    current = (index + buttons.length) % buttons.length;
    const button = buttons[current];
    const source = button.querySelector("img")!;
    mobile.srcset = button.dataset.detailMobile!;
    tablet.srcset = button.dataset.detailTablet!;
    image.src = button.dataset.detailDesktop!;
    image.alt = source.alt;
    counter.textContent = `${current + 1} / ${buttons.length}`;
    description.textContent = source.alt;
  }
  buttons.forEach((button, index) =>
    button.addEventListener("click", () => {
      show(index);
      dialog.showModal();
      document.body.style.overflow = "hidden";
    }),
  );
  dialog
    .querySelector(".close")!
    .addEventListener("click", () => dialog.close());
  dialog
    .querySelector(".previous")!
    .addEventListener("click", () => show(current - 1));
  dialog
    .querySelector(".next")!
    .addEventListener("click", () => show(current + 1));
  dialog.addEventListener("close", () => {
    document.body.style.overflow = "";
  });
  dialog.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      show(current + (event.key === "ArrowLeft" ? -1 : 1));
    }
  });
</script>

<style>
  main {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--space-page);
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 1.1rem 1.7rem;
    gap: 1rem;
  }
  h1 {
    font: inherit;
    margin: 0;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.3rem, 3.2vw, 3.4rem);
    align-items: start;
  }
  .artwork {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
    position: relative;
  }
  .artwork img {
    width: 100%;
  }
  picture {
    display: block;
  }
  .viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border: 0;
    padding: 1.4rem var(--space-page);
    background: #fff;
    color: var(--color-text);
  }
  .viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 1.5rem;
  }
  .viewer::backdrop {
    background: white;
  }
  .viewer-top,
  .viewer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .viewer button {
    background: none;
    border: 0;
    padding: 0.5rem 0;
    cursor: pointer;
    white-space: nowrap;
  }
  .viewer button:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .close span {
    font-size: 1.5rem;
  }
  .viewer-picture {
    min-height: 0;
  }
  .viewer-image {
    height: 100%;
    width: 100%;
    object-fit: contain;
    min-height: 0;
  }
  .description {
    margin: 0;
    color: var(--color-muted);
    text-align: center;
    font-size: 1rem;
  }
  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .section-heading {
      font-size: 1rem;
      padding-block: 0.7rem 1.2rem;
    }
    .gallery {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .description {
      display: none;
    }
    .viewer[open] {
      gap: 1rem;
    }
  }
</style>
