---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="About — Susana Silva"
  description="Illustrations by Susana Silva. Explore her illustrations and get in touch."
  activePage="about"
>
  <main id="main-content" class="information-page">
    <h1>About</h1>
    <p class="introduction">
      Susana Silva creates illustrations filled with color, botanical forms, and
      little stories.
    </p>
    <div class="information-grid">
      <section aria-labelledby="illustrations-heading">
        <h2 id="illustrations-heading">Illustrations</h2>
        <p>Portraits, flowers, and expressive compositions.</p>
        <a href="/">Explore the illustrations →</a>
      </section>
      <section aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact & follow</h2>
        <p>Let’s get in touch.</p>
        <a
          href="https://www.instagram.com/sigsillustration/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram — @sigsillustration ↗
        </a>
        <a
          href="https://www.behance.net/sigsillustration"
          target="_blank"
          rel="noopener noreferrer"
        >
          Behance — sigsillustration ↗
        </a>
      </section>
    </div>
  </main>
</SiteLayout>
