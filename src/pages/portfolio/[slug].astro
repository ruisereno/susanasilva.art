---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { artworks } from "../../data/portfolio";
export function getStaticPaths() {
  return artworks.map((artwork, index) => ({
    params: { slug: artwork.slug },
    props: {
      artwork,
      previous: artworks[(index + artworks.length - 1) % artworks.length]!,
      next: artworks[(index + 1) % artworks.length]!,
    },
  }));
}
const { artwork, previous, next } = Astro.props;
---

<SiteLayout
  title={`${artwork.title} — Susana Silva`}
  description={`${artwork.title} — Illustration by Susana Silva.`}
>
  <main id="main-content">
    <article class="project">
      <a
        class="image-link"
        href={artwork.detail.desktop}
        aria-label={`Open full-size image of ${artwork.title}`}
      >
        <img
          data-image-reveal
          src={artwork.detail.tablet}
          srcset={`${artwork.detail.mobile} 800w, ${artwork.detail.tablet} 1200w, ${artwork.detail.desktop} 1600w`}
          sizes={`(max-width: 640px) calc(100vw - 40px), min(calc(100vw - 40px), calc((100svh - 15rem) * ${artwork.width / artwork.height}))`}
          width={artwork.width}
          height={artwork.height}
          alt={artwork.title}
          decoding="async"
        />
      </a>
      <div class="project-info">
        <h1>{artwork.title}</h1>
      </div>
    </article>
    <nav class="project-navigation" aria-label="More illustrations">
      <a href={`/portfolio/${previous.slug}/`}>
        ← <span>{previous.title}</span>
      </a>
      <a class="all-illustrations" href="/">
        All illustrations
      </a>
      <a href={`/portfolio/${next.slug}/`}>
        <span>{next.title}</span> →
      </a>
    </nav>
  </main>
</SiteLayout>
<style>
  main {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--space-page);
  }
  .project {
    text-align: center;
  }
  .image-link {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100svh - 15rem);
    object-fit: contain;
  }
  .project-info {
    max-width: 42rem;
    margin-inline: auto;
    padding-top: 4rem;
  }
  h1 {
    font-size: 1.1rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    margin: 0 0 1rem;
  }
  .project-navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 2rem;
    margin-top: 5rem;
    font-size: 0.9rem;
  }
  .project-navigation a {
    text-decoration: none;
  }
  .project-navigation a:last-child {
    text-align: right;
  }
  .project-navigation a:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    img {
      max-height: none;
      width: 100%;
    }
    .image-link {
      width: 100%;
    }
    .project-info {
      padding-top: 2.5rem;
    }
    .project-navigation {
      grid-template-columns: 1fr 1fr;
      margin-top: 3rem;
      gap: 1.5rem;
      font-size: 0.85rem;
    }
    .all-illustrations {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: center;
    }
  }
</style>
