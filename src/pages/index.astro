---
import SiteLayout from "../layouts/SiteLayout.astro";
import ArtworkGallery from "../components/ArtworkGallery.astro";
---

<SiteLayout
  title="Susana Silva — Illustration"
  description="Selected illustrations by Susana Silva. Explore colorful portraits, botanicals, and compositions."
>
  <main id="main-content" aria-label="Selected illustrations">
    <h1 class="sr-only">Selected illustrations by Susana Silva</h1>
    <ArtworkGallery />
  </main>
</SiteLayout>
<style>
  main {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--space-page);
  }
</style>
