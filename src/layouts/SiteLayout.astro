---
import Layout from "./Layout.astro";
interface Props {
  title: string;
  description: string;
  activePage?: "about";
}
const { title, description, activePage } = Astro.props;
const links = [{ href: "/about/", label: "About", page: "about" }];
---

<Layout title={title} description={description}>
  <a class="skip-link" href="#main-content">
    Skip to content
  </a>
  <header>
    <a class="name" href="/" aria-label="Susana Silva home">
      Susana Silva
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={activePage === link.page ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <details class="mobile-menu">
      <summary aria-label="Navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={activePage === link.page ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </details>
  </header>
  <div class="header-space" aria-hidden="true"></div>
  <slot />
  <footer>
    <span>Susana Silva © {new Date().getFullYear()}</span>
    <div class="social-links">
      <a
        href="https://www.instagram.com/sigsillustration/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram
      </a>
      <a
        href="https://www.behance.net/sigsillustration"
        target="_blank"
        rel="noopener noreferrer"
      >
        Behance
      </a>
    </div>
  </footer>
</Layout>
<style>
  .skip-link {
    position: fixed;
    top: -5rem;
    left: 1rem;
    padding: 0.5rem 1rem;
    background: var(--color-background);
    z-index: 200;
  }
  .skip-link:focus {
    top: 1rem;
  }
  header {
    --header-background: rgb(250 250 250 / 80%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--header-background);
    padding: 20px 32px;
    gap: 2rem;
  }
  .header-space {
    height: 125px;
  }
  header a {
    text-decoration: none;
  }
  .name,
  .desktop-nav {
    font-size: 26px;
    line-height: 2.5;
    font-weight: 400;
    letter-spacing: 0;
  }
  .desktop-nav {
    display: flex;
    gap: 1.4rem;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .mobile-menu {
    display: none;
  }
  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    max-width: var(--content-width);
    margin-inline: auto;
    padding: 4rem var(--space-page) 2rem;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .social-links {
    display: flex;
    gap: 1.5rem;
  }
  footer a {
    text-decoration: none;
  }
  footer a:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    header {
      padding: 20px;
    }
    .header-space {
      height: 125px;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    summary {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      cursor: pointer;
      list-style: none;
      align-items: end;
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary span {
      display: block;
      width: 24px;
      height: 1px;
      background: var(--color-text);
    }
    .mobile-menu nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 10;
      background: var(--header-background);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1rem var(--space-page) 2rem;
      border-bottom: 1px solid #e5e5e5;
    }
    footer {
      padding-top: 3rem;
    }
  }
</style>
